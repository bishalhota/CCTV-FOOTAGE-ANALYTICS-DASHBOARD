# =============================================================================
# Store Intelligence — Event Engine Environment
# =============================================================================
# Copy to `.env`:  cp .env.example .env
# ⚠️  Never commit the actual `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL — Event Engine writes domain events to Postgres
# When running via docker-compose: POSTGRES_SERVER=postgres
# For local dev outside Docker: POSTGRES_SERVER=localhost
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=store_intelligence

# -----------------------------------------------------------------------------
# Redis Streams — Event Engine reads from `telemetry_resolved` stream
# When running via docker-compose: redis://redis:6379/0
# For local dev outside Docker: redis://localhost:6379/0
# -----------------------------------------------------------------------------
REDIS_URI=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
