# =============================================================================
# Store Intelligence — Edge Node Environment
# =============================================================================
# Copy to `.env`:  cp .env.example .env
# ⚠️  Never commit the actual `.env` file.
#
# The Edge Node is the CV pipeline (YOLOv8 + ByteTrack + ResNet18 ReID).
# It runs on-premises / locally — NOT in the cloud — because it requires
# video file access and 2–3 GB RAM for PyTorch models.
# =============================================================================

# -----------------------------------------------------------------------------
# Redis — Edge Node publishes raw telemetry to `telemetry_raw` stream
# When running via docker-compose: redis://redis:6379/0
# For local dev pointing at Docker Redis: redis://localhost:6379/0
# -----------------------------------------------------------------------------
REDIS_URI=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Store Identification
# Must match a store record in the database (seeded by backend-api on startup).
# Default store (NYC Flagship) ID:
# -----------------------------------------------------------------------------
STORE_ID=a1b2c3d4-0001-4000-8000-000000000001

# -----------------------------------------------------------------------------
# Camera Configuration
#
# MODE 1 — Multi-camera sequential (recommended):
# CAMERA_LIST: comma-separated pairs of "cam_id:/absolute/path/to/video.mp4"
# The edge node processes each camera one-by-one to keep CPU usage manageable.
#
# Example (5 cameras from mounted /videos directory):
# CAMERA_LIST=cam-1:/videos/CAM 1.mp4,cam-2:/videos/CAM 2.mp4,cam-3:/videos/CAM 3.mp4,cam-4:/videos/CAM 4.mp4,cam-5:/videos/CAM 5.mp4
#
# MODE 2 — Single camera (backward compatible):
# CAMERA_ID=cam-1
# VIDEO_PATH=/path/to/video.mp4
# or
# RTSP_URL=rtsp://192.168.1.10:554/stream1
# -----------------------------------------------------------------------------
CAMERA_LIST=cam-1:/videos/CAM 1.mp4,cam-2:/videos/CAM 2.mp4,cam-3:/videos/CAM 3.mp4,cam-4:/videos/CAM 4.mp4,cam-5:/videos/CAM 5.mp4

# Single camera alternative (used only if CAMERA_LIST is empty):
# CAMERA_ID=cam-1
# VIDEO_PATH=/path/to/video.mp4
# RTSP_URL=rtsp://your-camera-ip:554/stream1

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
