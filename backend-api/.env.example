# =============================================================================
# Store Intelligence — Backend API Environment
# =============================================================================
# Copy to `.env` for local development:  cp .env.example .env
# ⚠️  Never commit the actual `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Connection
# When running via docker-compose: POSTGRES_SERVER=postgres (service name)
# For local dev outside Docker: POSTGRES_SERVER=localhost
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=store_intelligence
POSTGRES_PORT=5432

# Alternatively, set a full DATABASE_URL to override individual components:
# SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://user:pass@host:5432/dbname

# -----------------------------------------------------------------------------
# Redis
# When running via docker-compose: redis://redis:6379/0
# For local dev outside Docker: redis://localhost:6379/0
# -----------------------------------------------------------------------------
REDIS_URI=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# -----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
